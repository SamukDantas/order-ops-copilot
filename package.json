{
  "name": "order-ops-copilot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "test": "node --test lib/*.test.mjs && deno test supabase/functions/_shared/",
    "workflows": "node scripts/gerar-workflows.mjs",
    "n8n:up": "docker compose -f n8n/docker-compose.yml up -d",
    "n8n:import": "node scripts/n8n-importar.mjs",
    "db:reset": "npx -y supabase@latest db reset",
    "functions:serve": "npx -y supabase@latest functions serve --env-file supabase/functions/.env --no-verify-jwt",
    "simular": "node scripts/simular-webhook.mjs",
    "eval": "node --env-file=.env scripts/eval.mjs",
    "test:integration": "node --test tests/",
    "seed:usuarios": "node scripts/seed-usuarios.mjs",
    "web": "npm run dev --prefix web",
    "gateway": "node --env-file=.env services/llm-gateway.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
