# Copie para .env (nunca versionado). `npm run setup` preenche o que der automaticamente.

# ─── LLM ─────────────────────────────────────────────────────────────
# codex (padrão): Codex CLI com o login da conta ChatGPT, sem chave de API
# anthropic: Messages API, exige ANTHROPIC_API_KEY com crédito
LLM_PROVEDOR=codex
CODEX_RUN_MODEL=gpt-5.6-luna
CODEX_FALLBACK_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
# Gateway no host que o n8n chama (npm run gateway)
LLM_GATEWAY_URL=http://host.docker.internal:8787
LLM_GATEWAY_SECRET=

# ─── Supabase ────────────────────────────────────────────────────────
# URL vista de dentro do container do n8n (Supabase local no host)
SUPABASE_URL=http://host.docker.internal:54321
# Chave secreta (service role). Local: `npx supabase status`
SUPABASE_SECRET_KEY=

# ─── n8n ─────────────────────────────────────────────────────────────
# URL que o próprio n8n usa para chamar seus webhooks
N8N_BASE_URL=http://localhost:5678
# Segredo compartilhado exigido nos webhooks do n8n (header x-webhook-secret)
N8N_WEBHOOK_SECRET=

# ─── Shopify ─────────────────────────────────────────────────────────
# Client secret do app (assina os webhooks com HMAC)
SHOPIFY_WEBHOOK_SECRET=dev-shopify-secret
# mock: registra o write-back sem chamar o Shopify | live: chama a Admin API
SHOPIFY_MODE=mock
SHOPIFY_ADMIN_TOKEN=
