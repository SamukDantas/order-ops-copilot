# Copie para .env (nunca versionado). `npm run setup` preenche o que der automaticamente.

# ─── LLM ─────────────────────────────────────────────────────────────
# codex (padrão): Codex CLI com o login da conta ChatGPT, sem chave de API
# anthropic: Messages API, exige ANTHROPIC_API_KEY com crédito
LLM_PROVEDOR=codex
CODEX_RUN_MODEL=gpt-5.6-luna
CODEX_FALLBACK_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
# Gateway no host que o n8n chama (npm run gateway)
LLM_GATEWAY_URL=http://host.docker.internal:8787
LLM_GATEWAY_SECRET=

# ─── Supabase ────────────────────────────────────────────────────────
# URL vista de dentro do container do n8n (Supabase local no host)
SUPABASE_URL=http://host.docker.internal:54321
# Chave secreta (service role). Local: `npx supabase status`
SUPABASE_SECRET_KEY=

# ─── n8n ─────────────────────────────────────────────────────────────
# URL que o próprio n8n usa para chamar seus webhooks
N8N_BASE_URL=http://localhost:5678
# Segredo compartilhado exigido nos webhooks do n8n (header x-webhook-secret)
N8N_WEBHOOK_SECRET=

# ─── Shopify ─────────────────────────────────────────────────────────
# Segredo que assina os webhooks simulados (npm run simular). Na Edge Function
# da nuvem, que recebe os webhooks da loja real, vale o client secret do app.
SHOPIFY_WEBHOOK_SECRET=dev-shopify-secret
# mock: registra o write-back sem chamar o Shopify | live: chama a Admin API
# (só para a loja SHOPIFY_STORE_DOMAIN; as marcas fictícias seguem em mock)
SHOPIFY_MODE=mock
# Loja de desenvolvimento real e app do Dev Dashboard (npm run shopify)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ─── Demo online (Supabase na nuvem) ─────────────────────────────────
# Senha do banco do projeto na nuvem (npx supabase link / db push / demo:carregar)
SUPABASE_DB_PASSWORD=
# E-mail do usuário demo criado no painel do Supabase
DEMO_EMAIL=

# ─── Túnel (npm run tunel) ───────────────────────────────────────────
# Domínio estático do ngrok que expõe só os webhooks do n8n, para a Edge
# Function na nuvem e o dashboard na Vercel alcançarem o pipeline local
NGROK_DOMAIN=
# Caminho do executável, se o ngrok não estiver no PATH
NGROK_BIN=
