{
  "id": "ooAplicarDecisa1",
  "name": "Aplicar decisão no Shopify",
  "active": false,
  "nodes": [
    {
      "id": "webhook-aplicar-decisao",
      "name": "Webhook: aplicar decisão",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "5b1f2a4e-8c1d-4e0b-9a51-3f7a2d6c1e02",
      "parameters": {
        "httpMethod": "POST",
        "path": "apply-decision",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 202
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ooCredWebhook001",
          "name": "n8n webhook secret"
        }
      }
    },
    {
      "id": "buscar-pedido",
      "name": "Buscar pedido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/orders?id=eq.{{ $json.body.order_id }}&select=id,order_number,shopify_order_id,status,brands(shop_domain),order_items(title,reviews(verdict,created_at,review_decisions(action,final_text,created_at)))",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.pgrst.object+json"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "ooCredSupabase01",
          "name": "Supabase service role"
        }
      }
    },
    {
      "id": "montar-tags-e-nota",
      "name": "Montar tags e nota",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const o = $json;\nconst TAGS = {\n  auto_approved: [\"personalisation-ok\", \"ai-reviewed\"],\n  approved: [\"personalisation-ok\", \"human-reviewed\"],\n  rejected: [\"personalisation-hold\", \"human-reviewed\"],\n};\nconst tags = TAGS[o.status];\nif (!tags) throw new Error(\"Pedido \" + o.order_number + \" não está decidido (status: \" + o.status + \")\");\n\nconst lines = [];\nfor (const item of o.order_items ?? []) {\n  const review = (item.reviews ?? []).sort((a, b) => b.created_at.localeCompare(a.created_at))[0];\n  const decision = (review?.review_decisions ?? []).sort((a, b) => b.created_at.localeCompare(a.created_at))[0];\n  if (decision?.action === \"edit\") {\n    lines.push(item.title + \": produce as \" + decision.final_text.map((f) => f.name + ' = \"' + f.value + '\"').join(\", \"));\n  } else if (decision?.action === \"reject\") {\n    lines.push(item.title + \": ON HOLD, contact customer\");\n  }\n}\nconst note = \"[Order Ops Copilot] \" + (o.status === \"auto_approved\" ? \"Personalisation auto-approved.\" : \"Reviewed by operations.\")\n  + (lines.length ? \"\\n\" + lines.join(\"\\n\") : \"\");\n\nreturn { json: {\n  order_id: o.id,\n  shop_domain: o.brands.shop_domain,\n  order_gid: \"gid://shopify/Order/\" + o.shopify_order_id,\n  tags, note,\n  mode: $env.SHOPIFY_MODE === \"live\" ? \"live\" : \"mock\",\n}};"
      }
    },
    {
      "id": "shopify-em-modo-live",
      "name": "Shopify em modo live?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "shopify-em-modo-live-c",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "live",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "shopify-tags-nota",
      "name": "Shopify: tags + nota",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $json.shop_domain }}/admin/api/2026-07/graphql.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  query: \"mutation($id: ID!, $tags: [String!]!, $input: OrderInput!) { tagsAdd(id: $id, tags: $tags) { userErrors { message } } orderUpdate(input: $input) { userErrors { message } } }\",\n  variables: { id: $json.order_gid, tags: $json.tags, input: { id: $json.order_gid, note: $json.note } }\n}) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ooCredShopify001",
          "name": "Shopify Admin API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "simular-shopify-mock",
      "name": "Simular Shopify (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { data: { tagsAdd: { userErrors: [] }, orderUpdate: { userErrors: [] } }, mock: true } };"
      }
    },
    {
      "id": "resultado-do-write-back",
      "name": "Resultado do write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $(\"Montar tags e nota\").item.json;\nconst errors = [...($json.data?.tagsAdd?.userErrors ?? []), ...($json.data?.orderUpdate?.userErrors ?? []), ...($json.errors ?? [])];\nreturn { json: { order_id: ctx.order_id, mode: ctx.mode, tags: ctx.tags, note: ctx.note, ok: errors.length === 0, response: $json } };"
      }
    },
    {
      "id": "registrar-sync",
      "name": "Registrar sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/shopify_sync_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "ooCredSupabase01",
          "name": "Supabase service role"
        }
      }
    }
  ],
  "connections": {
