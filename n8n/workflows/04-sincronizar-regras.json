      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "5b1f2a4e-8c1d-4e0b-9a51-3f7a2d6c1e04",
      "parameters": {
        "httpMethod": "POST",
        "path": "sync-rules",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 202
        }
      },
