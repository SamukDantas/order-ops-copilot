        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($(\"Mapear regras\").item.json.problems.map((m) => ({ workflow: \"Sincronizar regras do Shopify\", node: \"Mapear regras\", message: m }))) }}",
        "options": {}
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "ooCredSupabase01",
          "name": "Supabase service role"
        }
      }
    }
